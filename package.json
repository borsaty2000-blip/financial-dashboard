{
	"name": "financial-dashboard",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"client": "npm --prefix client run dev",
		"server": "tsx server/index.ts",
		"build": "npm run typecheck && npm --prefix client run build",
		"typecheck": "tsc --noEmit",
		"lint": "npm --prefix client run lint",
		"test": "npm --prefix client run test",
		"test:auth": "tsx --test server/auth.validator.test.ts",
		"test:watch": "npm --prefix client run test:watch",
		"coverage": "npm --prefix client run coverage",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@prisma/client": "^6.17.1",
		"bcryptjs": "^3.0.3",
		"dotenv": "^17.4.2",
		"express": "^4.22.2",
		"jose": "^6.2.12",
		"multer": "^2.3.0",
		"zod": "^4.6.4"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/express": "^4.17.21",
		"@types/multer": "^2.2.0",
		"@types/node": "^24.13.3",
		"prettier": "^3.9.6",
		"prisma": "^6.17.1",
		"tsx": "^4.23.8",
		"typescript": "~6.0.2"
	}
}
