{
	"name": "financial-dashboard",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"client": "npm --prefix client run dev",
		"server": "tsx server/index.ts",
		"build": "npm run typecheck && npm --prefix client run build",
		"typecheck": "tsc --noEmit",
		"lint": "npm --prefix client run lint",
		"test": "npm --prefix client run test",
		"test:auth": "tsx --test server/auth.validator.test.ts",
		"test:watch": "npm --prefix client run test:watch",
		"coverage": "npm --prefix client run coverage",
		"typecheck:packages": "tsc -p packages/types/tsconfig.json && tsc -p packages/utils/tsconfig.json && tsc -p packages/design-system/tsconfig.json && tsc -p packages/charts/tsconfig.json && tsc -p packages/widgets/tsconfig.json && tsc -p packages/strategies/tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@halalterminal/sdk": "github:borsaty2000-blip/halalterminal-sdk-js",
		"@neabytelab/trading-lib": "github:borsaty2000-blip/Trading-Lib",
		"@prisma/client": "^6.17.1",
		"@sentry/node": "^10.74.0",
		"bcryptjs": "^3.0.3",
		"dotenv": "^17.4.2",
		"express": "^4.22.2",
		"finmagic": "^1.0.4",
		"helmet": "^8.3.0",
		"i18next": "^26.4.2",
		"i18next-browser-languagedetector": "^8.2.1",
		"jose": "^6.2.12",
		"lightweight-charts": "^5.2.1",
		"lightweight-charts-drawing": "github:borsaty2000-blip/lightweight-charts-drawing",
		"multer": "^2.3.0",
		"nodemailer": "^10.0.9",
		"otplib": "^13.5.0",
		"pdfkit": "^0.20.2",
		"qrcode": "^1.5.4",
		"react-i18next": "^17.0.14",
		"socket.io": "^4.8.3",
		"trading-signals": "^8.3.0",
		"web-push": "^3.6.7",
		"zod": "^4.6.4"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/express": "^4.17.21",
		"@types/multer": "^2.2.0",
		"@types/node": "^24.13.3",
		"@types/nodemailer": "^8.0.1",
		"@types/pdfkit": "^0.17.6",
		"@types/qrcode": "^1.5.6",
		"@types/web-push": "^3.6.4",
		"prettier": "^3.9.6",
		"prisma": "^6.17.1",
		"tsx": "^4.23.8",
		"typescript": "~6.0.2"
	}
}
