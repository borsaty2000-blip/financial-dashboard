{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install --include=dev && npm --prefix client install --include=dev",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/**"
    },
    "api/python/*.py": {
      "runtime": "python3.11",
      "includeFiles": "server/python-services/**"
    }
  },
  "rewrites": [
    { "source": "/api/python/(.*)", "destination": "/api/python/$1" },
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
