{
	"version": 2,
	"buildCommand": "npm run build",
	"installCommand": "npm install && npm --prefix client install",
	"outputDirectory": "client/dist",
	"functions": {
		"api/index.ts": {
			"includeFiles": "server/data.json"
		}
	},
	"rewrites": [
		{ "source": "/api/(.*)", "destination": "/api/index.ts" },
		{ "source": "/(.*)", "destination": "/index.html" }
	]
}
