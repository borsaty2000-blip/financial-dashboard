{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Node",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"ignoreDeprecations": "6.0",
		"typeRoots": [
			"../../client/node_modules/@types",
			"../../node_modules/@types"
		]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}
