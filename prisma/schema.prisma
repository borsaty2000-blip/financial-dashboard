generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  username             String                @unique
  passwordHash         String
  fullName             String?
  avatarUrl            String?
  bio                  String?               @db.VarChar(500)
  country              String?               @default("EG")
  language             String                @default("ar")
  isVerified           Boolean               @default(false)
  isActive             Boolean               @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  preference           UserPreference?
  achievements         UserAchievement[]
  sessions             Session[]
  passwordResets       PasswordReset[]
  following            Follow[]              @relation("Following")
  followers            Follow[]              @relation("Followers")
  watchlists           Watchlist[]
  priceAlerts          PriceAlert[]
  notifications        Notification[]
  portfolio            Portfolio?
  orders               Order[]
  apiKeys              ApiKey[]
  apiSubscription      ApiSubscription?
  analystProfile       AnalystProfile?
  analystSubscriptions AnalystSubscription[] @relation("Subscriber")
  analystSubscribers   AnalystSubscription[] @relation("Analyst")
  savedScreeners       SavedScreener[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model UserPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredMarkets    String[] @default([])
  experienceLevel     String   @default("BEGINNER")
  investmentStyle     String   @default("BALANCED")
  preferredSectors    String[] @default([])
  dailyTimeCommitment String   @default("MEDIUM")
  theme               String   @default("light")
  emailNotifications  Boolean  @default(true)
  pushNotifications   Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("user_preferences")
}

model Achievement {
  id          String            @id @default(uuid())
  code        String            @unique
  nameAr      String
  nameEn      String
  description String
  icon        String
  category    String
  points      Int               @default(10)
  users       UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  progress      Int         @default(0)
  completed     Boolean     @default(false)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

model Watchlist {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String          @default("قائمتي")
  isDefault Boolean         @default(false)
  items     WatchlistItem[]
  createdAt DateTime        @default(now())

  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id          String    @id @default(uuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  symbol      String
  market      String    @default("EGX")
  addedAt     DateTime  @default(now())

  @@unique([watchlistId, symbol])
  @@index([watchlistId])
  @@map("watchlist_items")
}

model PriceAlert {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  market      String    @default("EGX")
  condition   String
  targetValue Float
  isActive    Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, isActive])
  @@index([symbol])
  @@map("price_alerts")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model Portfolio {
  id             String     @id @default(uuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance        Float      @default(100000)
  initialCapital Float      @default(100000)
  positions      Position[]
  orders         Order[]
  createdAt      DateTime   @default(now())

  @@map("portfolios")
}

model Position {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol      String
  quantity    Int
  avgPrice    Float
  realizedPnl Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([portfolioId, symbol])
  @@map("positions")
}

model Order {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])
  symbol      String
  side        String
  orderType   String    @default("MARKET")
  quantity    Int
  price       Float
  totalCost   Float
  status      String    @default("FILLED")
  executedAt  DateTime  @default(now())

  @@index([userId, executedAt])
  @@map("orders")
}

model ApiKey {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  keyHash      String        @unique
  keyPrefix    String
  lastUsedAt   DateTime?
  requestCount Int           @default(0)
  tier         String        @default("FREE")
  dailyLimit   Int           @default(100)
  monthlyLimit Int           @default(3000)
  isActive     Boolean       @default(true)
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  revokedAt    DateTime?
  usageLogs    ApiUsageLog[]

  @@index([userId])
  @@map("api_keys")
}

model ApiUsageLog {
  id         String   @id @default(uuid())
  apiKeyId   String
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  endpoint   String
  method     String
  statusCode Int
  latencyMs  Int
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@map("api_usage_logs")
}

model ApiSubscription {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier          String    @default("FREE")
  monthlyPrice  Float     @default(0)
  startsAt      DateTime  @default(now())
  endsAt        DateTime?
  autoRenew     Boolean   @default(false)
  paymentMethod String?
  status        String    @default("ACTIVE")

  @@map("api_subscriptions")
}

model AnalystProfile {
  id                String        @id @default(uuid())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String
  bio               String?       @db.VarChar(1000)
  specialties       String[]      @default([])
  experience        Int           @default(0)
  credentials       String[]      @default([])
  isVerified        Boolean       @default(false)
  verificationDate  DateTime?
  subscriptionPrice Float         @default(0)
  totalSubscribers  Int           @default(0)
  totalRevenue      Float         @default(0)
  rating            Float         @default(0)
  reviewCount       Int           @default(0)
  status            String        @default("PENDING")
  posts             AnalystPost[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("analyst_profiles")
}

model AnalystSubscription {
  id           String    @id @default(uuid())
  subscriberId String
  analystId    String
  subscriber   User      @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  analyst      User      @relation("Analyst", fields: [analystId], references: [id], onDelete: Cascade)
  status       String    @default("ACTIVE")
  price        Float     @default(0)
  startsAt     DateTime  @default(now())
  endsAt       DateTime?
  createdAt    DateTime  @default(now())

  @@unique([subscriberId, analystId])
  @@index([analystId])
  @@map("analyst_subscriptions")
}

model AnalystPost {
  id        String         @id @default(uuid())
  analystId String
  analyst   AnalystProfile @relation(fields: [analystId], references: [id], onDelete: Cascade)
  symbol    String?
  type      String
  title     String
  content   String         @db.Text
  charts    String[]       @default([])
  sentiment String?
  isPremium Boolean        @default(false)
  views     Int            @default(0)
  likes     Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([analystId, createdAt])
  @@map("analyst_posts")
}

model WhatsAppSubscription {
  id               String   @id @default(uuid())
  userId           String   @unique
  phoneNumber      String
  isVerified       Boolean  @default(false)
  verificationCode String?
  alertTypes       String[] @default([])
  createdAt        DateTime @default(now())

  @@map("whatsapp_subscriptions")
}

model TelegramSubscription {
  id         String   @id @default(uuid())
  userId     String?  @unique
  chatId     String   @unique
  username   String?
  isActive   Boolean  @default(true)
  alertTypes String[] @default([])
  createdAt  DateTime @default(now())

  @@map("telegram_subscriptions")
}

model MarketCandle {
  id        String   @id @default(uuid())
  symbol    String
  market    String
  interval  String
  date      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float    @default(0)
  source    String
  createdAt DateTime @default(now())

  @@unique([symbol, market, interval, date])
  @@index([symbol, market, date])
  @@map("market_candles")
}

model EconomicEvent {
  id         String   @id @default(uuid())
  eventKey   String   @unique
  date       DateTime
  country    String
  category   String
  title      String
  importance String
  previous   String?
  forecast   String?
  actual     String?
  source     String   @default("manual")
  createdAt  DateTime @default(now())

  @@index([date, country, importance])
  @@map("economic_events")
}

model SavedScreener {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_screeners")
}

model IPOEvent {
  id                String    @id @default(uuid())
  symbol            String
  companyName       String
  nameAr            String
  market            String
  ipoDate           DateTime
  priceRange        String
  sharesOffered     BigInt
  totalValue        Float
  status            String
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  createdAt         DateTime  @default(now())

  @@index([ipoDate])
  @@map("ipo_events")
}

model DividendEvent {
  id           String   @id @default(uuid())
  symbol       String
  market       String
  amount       Float
  currency     String
  exDate       DateTime
  recordDate   DateTime
  paymentDate  DateTime
  yieldPercent Float
  status       String
  createdAt    DateTime @default(now())

  @@index([exDate])
  @@map("dividend_events")
}

model EarningsEvent {
  id              String   @id @default(uuid())
  symbol          String
  market          String
  quarter         String
  fiscalYear      Int
  reportDate      DateTime
  timeOfDay       String
  epsEstimate     Float?
  epsActual       Float?
  revenueEstimate Float?
  revenueActual   Float?
  surprise        Float?
  createdAt       DateTime @default(now())

  @@index([reportDate])
  @@map("earnings_events")
}

model SplitEvent {
  id        String   @id @default(uuid())
  symbol    String
  market    String
  splitDate DateTime
  ratio     String
  oldShares BigInt
  newShares BigInt
  createdAt DateTime @default(now())

  @@index([splitDate])
  @@map("split_events")
}

model InsiderTrade {
  id              String   @id @default(uuid())
  symbol          String
  insiderName     String
  insiderRole     String
  transactionType String
  shares          Int
  price           Float
  totalValue      Float
  transactionDate DateTime
  filingDate      DateTime
  source          String

  @@index([symbol, transactionDate])
  @@map("insider_trades")
}
