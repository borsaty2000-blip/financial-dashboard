generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  username             String                @unique
  passwordHash         String
  fullName             String?
  avatarUrl            String?
  bio                  String?               @db.VarChar(500)
  country              String?               @default("EG")
  language             String                @default("ar")
  isVerified           Boolean               @default(false)
  isActive             Boolean               @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  preference           UserPreference?
  achievements         UserAchievement[]
  sessions             Session[]
  passwordResets       PasswordReset[]
  following            Follow[]              @relation("Following")
  followers            Follow[]              @relation("Followers")
  watchlists           Watchlist[]
  priceAlerts          PriceAlert[]
  notifications        Notification[]
  portfolio            Portfolio?
  orders               Order[]
  apiKeys              ApiKey[]
  apiSubscription      ApiSubscription?
  analystProfile       AnalystProfile?
  analystSubscriptions AnalystSubscription[] @relation("Subscriber")
  analystSubscribers   AnalystSubscription[] @relation("Analyst")
  savedScreeners       SavedScreener[]
  pushSubscriptions    PushSubscription[]
  pushNotifications    PushNotification[]
  loginHistory         LoginHistory[]
  coursesTaught        Course[]              @relation("CourseInstructor")
  enrollments          CourseEnrollment[]
  certificates         Certificate[]
  forumTopics          ForumTopic[]
  forumReplies         ForumReply[]
  reputation           UserReputation?
  videos               Video[]               @relation("VideoAuthor")
  webinarsHosted       Webinar[]             @relation("WebinarHost")
  organizationMembers  OrganizationMember[]
  referralsSent        Referral[]            @relation("Referrer")
  referralsReceived    Referral[]            @relation("Referred")
  referralCode         ReferralCode?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean               @default(false)
  supportTickets       SupportTicket[]
  blogPosts            BlogPost[]            @relation("BlogAuthor")
  blogComments         BlogComment[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model UserPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredMarkets    String[] @default([])
  experienceLevel     String   @default("BEGINNER")
  investmentStyle     String   @default("BALANCED")
  preferredSectors    String[] @default([])
  dailyTimeCommitment String   @default("MEDIUM")
  theme               String   @default("light")
  emailNotifications  Boolean  @default(true)
  pushNotifications   Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("user_preferences")
}

model Achievement {
  id          String            @id @default(uuid())
  code        String            @unique
  nameAr      String
  nameEn      String
  description String
  icon        String
  category    String
  points      Int               @default(10)
  users       UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  progress      Int         @default(0)
  completed     Boolean     @default(false)
  completedAt   DateTime?
  createdAt     DateTime    @default(now())

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  location  String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("login_history")
}

model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String
  p256dh     String
  auth       String
  deviceType String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId, isActive])
  @@map("push_subscriptions")
}

model PushNotification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  icon      String?
  link      String?
  data      Json?
  sent      Boolean   @default(false)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, sent])
  @@map("push_notifications")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

model Watchlist {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String          @default("قائمتي")
  isDefault Boolean         @default(false)
  items     WatchlistItem[]
  createdAt DateTime        @default(now())

  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id          String    @id @default(uuid())
  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  symbol      String
  market      String    @default("EGX")
  addedAt     DateTime  @default(now())

  @@unique([watchlistId, symbol])
  @@index([watchlistId])
  @@map("watchlist_items")
}

model PriceAlert {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  market      String    @default("EGX")
  condition   String
  targetValue Float
  isActive    Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, isActive])
  @@index([symbol])
  @@map("price_alerts")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model Portfolio {
  id             String     @id @default(uuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance        Float      @default(100000)
  initialCapital Float      @default(100000)
  positions      Position[]
  orders         Order[]
  createdAt      DateTime   @default(now())

  @@map("portfolios")
}

model Position {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol      String
  quantity    Int
  avgPrice    Float
  realizedPnl Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([portfolioId, symbol])
  @@map("positions")
}

model Order {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])
  symbol      String
  side        String
  orderType   String    @default("MARKET")
  quantity    Int
  price       Float
  totalCost   Float
  status      String    @default("FILLED")
  executedAt  DateTime  @default(now())

  @@index([userId, executedAt])
  @@map("orders")
}

model ApiKey {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  keyHash      String        @unique
  keyPrefix    String
  lastUsedAt   DateTime?
  requestCount Int           @default(0)
  tier         String        @default("FREE")
  dailyLimit   Int           @default(100)
  monthlyLimit Int           @default(3000)
  isActive     Boolean       @default(true)
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  revokedAt    DateTime?
  usageLogs    ApiUsageLog[]

  @@index([userId])
  @@map("api_keys")
}

model ApiUsageLog {
  id         String   @id @default(uuid())
  apiKeyId   String
  apiKey     ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  endpoint   String
  method     String
  statusCode Int
  latencyMs  Int
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@map("api_usage_logs")
}

model ApiSubscription {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier          String    @default("FREE")
  monthlyPrice  Float     @default(0)
  startsAt      DateTime  @default(now())
  endsAt        DateTime?
  autoRenew     Boolean   @default(false)
  paymentMethod String?
  status        String    @default("ACTIVE")

  @@map("api_subscriptions")
}

model AnalystProfile {
  id                String        @id @default(uuid())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String
  bio               String?       @db.VarChar(1000)
  specialties       String[]      @default([])
  experience        Int           @default(0)
  credentials       String[]      @default([])
  isVerified        Boolean       @default(false)
  verificationDate  DateTime?
  subscriptionPrice Float         @default(0)
  totalSubscribers  Int           @default(0)
  totalRevenue      Float         @default(0)
  rating            Float         @default(0)
  reviewCount       Int           @default(0)
  status            String        @default("PENDING")
  posts             AnalystPost[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("analyst_profiles")
}

model AnalystSubscription {
  id           String    @id @default(uuid())
  subscriberId String
  analystId    String
  subscriber   User      @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  analyst      User      @relation("Analyst", fields: [analystId], references: [id], onDelete: Cascade)
  status       String    @default("ACTIVE")
  price        Float     @default(0)
  startsAt     DateTime  @default(now())
  endsAt       DateTime?
  createdAt    DateTime  @default(now())

  @@unique([subscriberId, analystId])
  @@index([analystId])
  @@map("analyst_subscriptions")
}

model AnalystPost {
  id        String         @id @default(uuid())
  analystId String
  analyst   AnalystProfile @relation(fields: [analystId], references: [id], onDelete: Cascade)
  symbol    String?
  type      String
  title     String
  content   String         @db.Text
  charts    String[]       @default([])
  sentiment String?
  isPremium Boolean        @default(false)
  views     Int            @default(0)
  likes     Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([analystId, createdAt])
  @@map("analyst_posts")
}

model WhatsAppSubscription {
  id               String   @id @default(uuid())
  userId           String   @unique
  phoneNumber      String
  isVerified       Boolean  @default(false)
  verificationCode String?
  alertTypes       String[] @default([])
  createdAt        DateTime @default(now())

  @@map("whatsapp_subscriptions")
}

model TelegramSubscription {
  id         String   @id @default(uuid())
  userId     String?  @unique
  chatId     String   @unique
  username   String?
  isActive   Boolean  @default(true)
  alertTypes String[] @default([])
  createdAt  DateTime @default(now())

  @@map("telegram_subscriptions")
}

model MarketCandle {
  id        String   @id @default(uuid())
  symbol    String
  market    String
  interval  String
  date      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float    @default(0)
  source    String
  createdAt DateTime @default(now())

  @@unique([symbol, market, interval, date])
  @@index([symbol, market, date])
  @@map("market_candles")
}

model Signal {
  id          String   @id @default(cuid())
  symbol      String
  market      String
  timeframe   String
  signalType  String
  entryPrice  Float
  stopLoss    Float
  target1     Float?
  target2     Float?
  target3     Float?
  confluence  Int
  reason      String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  outcome     String?
  pnlPercent  Float?

  @@index([symbol, status, createdAt])
  @@map("signals")
}

model EgxCompany {
  id         String   @id @default(uuid())
  sourceCode String   @unique
  symbol     String   @unique
  nameAr     String
  market     String   @default("EGX")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([market, symbol])
  @@map("egx_companies")
}

model TasiCompany {
  id         String   @id @default(uuid())
  sourceCode String   @unique
  symbol     String   @unique
  nameAr     String
  market     String   @default("TASI")
  sector     String?
  currency   String   @default("SAR")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([market, symbol])
  @@map("tasi_companies")
}

model EconomicEvent {
  id         String   @id @default(uuid())
  eventKey   String   @unique
  date       DateTime
  country    String
  category   String
  title      String
  importance String
  previous   String?
  forecast   String?
  actual     String?
  source     String   @default("manual")
  createdAt  DateTime @default(now())

  @@index([date, country, importance])
  @@map("economic_events")
}

model SavedScreener {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_screeners")
}

model IPOEvent {
  id                String    @id @default(uuid())
  symbol            String
  companyName       String
  nameAr            String
  market            String
  ipoDate           DateTime
  priceRange        String
  sharesOffered     BigInt
  totalValue        Float
  status            String
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  createdAt         DateTime  @default(now())

  @@index([ipoDate])
  @@map("ipo_events")
}

model DividendEvent {
  id           String   @id @default(uuid())
  symbol       String
  market       String
  amount       Float
  currency     String
  exDate       DateTime
  recordDate   DateTime
  paymentDate  DateTime
  yieldPercent Float
  status       String
  createdAt    DateTime @default(now())

  @@index([exDate])
  @@map("dividend_events")
}

model EarningsEvent {
  id              String   @id @default(uuid())
  symbol          String
  market          String
  quarter         String
  fiscalYear      Int
  reportDate      DateTime
  timeOfDay       String
  epsEstimate     Float?
  epsActual       Float?
  revenueEstimate Float?
  revenueActual   Float?
  surprise        Float?
  createdAt       DateTime @default(now())

  @@index([reportDate])
  @@map("earnings_events")
}

model SplitEvent {
  id        String   @id @default(uuid())
  symbol    String
  market    String
  splitDate DateTime
  ratio     String
  oldShares BigInt
  newShares BigInt
  createdAt DateTime @default(now())

  @@index([splitDate])
  @@map("split_events")
}

model InsiderTrade {
  id              String   @id @default(uuid())
  symbol          String
  insiderName     String
  insiderRole     String
  transactionType String
  shares          Int
  price           Float
  totalValue      Float
  transactionDate DateTime
  filingDate      DateTime
  source          String

  @@index([symbol, transactionDate])
  @@map("insider_trades")
}

model Course {
  id            String             @id @default(uuid())
  title         String
  titleEn       String?
  description   String             @db.Text
  level         String
  category      String
  duration      Int
  thumbnail     String?
  price         Float              @default(0)
  isFree        Boolean            @default(true)
  instructorId  String?
  instructor    User?              @relation("CourseInstructor", fields: [instructorId], references: [id])
  lessons       Lesson[]
  enrollments   CourseEnrollment[]
  rating        Float              @default(0)
  totalStudents Int                @default(0)
  isPublished   Boolean            @default(false)
  createdAt     DateTime           @default(now())

  @@index([level, category])
  @@map("courses")
}

model Lesson {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  videoUrl  String?
  duration  Int
  order     Int
  quiz      Json?
  resources String[] @default([])

  @@index([courseId, order])
  @@map("lessons")
}

model CourseEnrollment {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress         Int       @default(0)
  completedLessons String[]  @default([])
  score            Int?
  certificateId    String?   @unique
  enrolledAt       DateTime  @default(now())
  completedAt      DateTime?

  @@unique([userId, courseId])
  @@map("course_enrollments")
}

model Certificate {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  certificateUrl   String
  verificationCode String   @unique
  issuedAt         DateTime @default(now())

  @@index([userId])
  @@map("certificates")
}

model ForumCategory {
  id     String       @id @default(uuid())
  name   String
  nameEn String?
  icon   String?
  order  Int          @default(0)
  topics ForumTopic[]

  @@map("forum_categories")
}

model ForumTopic {
  id          String        @id @default(uuid())
  categoryId  String
  category    ForumCategory @relation(fields: [categoryId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  title       String
  content     String        @db.Text
  tags        String[]      @default([])
  views       Int           @default(0)
  replyCount  Int           @default(0)
  isPinned    Boolean       @default(false)
  isLocked    Boolean       @default(false)
  lastReplyAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  replies     ForumReply[]

  @@index([categoryId, createdAt])
  @@map("forum_topics")
}

model ForumReply {
  id        String     @id @default(uuid())
  topicId   String
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  content   String     @db.Text
  likes     Int        @default(0)
  isAnswer  Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([topicId, createdAt])
  @@map("forum_replies")
}

model UserReputation {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points          Int      @default(0)
  level           String   @default("NEWBIE")
  badges          String[] @default([])
  helpfulAnswers  Int      @default(0)
  acceptedAnswers Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@map("user_reputations")
}

model Video {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  url         String
  thumbnail   String?
  duration    Int      @default(0)
  category    String
  symbol      String?
  authorId    String
  author      User     @relation("VideoAuthor", fields: [authorId], references: [id])
  views       Int      @default(0)
  likes       Int      @default(0)
  isPremium   Boolean  @default(false)
  publishedAt DateTime @default(now())

  @@index([category, publishedAt])
  @@map("videos")
}

model Webinar {
  id           String   @id @default(uuid())
  title        String
  description  String   @db.Text
  hostId       String
  host         User     @relation("WebinarHost", fields: [hostId], references: [id])
  scheduledAt  DateTime
  duration     Int      @default(60)
  maxAttendees Int?
  attendees    Int      @default(0)
  meetingUrl   String?
  recordingUrl String?
  status       String   @default("SCHEDULED")

  @@index([scheduledAt])
  @@map("webinars")
}

model Organization {
  id           String               @id @default(uuid())
  name         String
  nameEn       String?
  type         String
  tier         String               @default("BASIC")
  maxUsers     Int                  @default(10)
  logoUrl      String?
  website      String?
  contactEmail String
  contactPhone String?
  isVerified   Boolean              @default(false)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  members      OrganizationMember[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER")
  joinedAt       DateTime     @default(now())

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Referral {
  id           String    @id @default(uuid())
  referrerId   String
  referrer     User      @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId   String
  referred     User      @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  code         String    @unique
  status       String    @default("PENDING")
  rewardAmount Float?
  rewardType   String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([referrerId])
  @@map("referrals")
}

model ReferralCode {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String   @unique
  uses        Int      @default(0)
  maxUses     Int?
  totalReward Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("referral_codes")
}

model BlogPost {
  id             String        @id @default(uuid())
  slug           String        @unique
  title          String
  titleEn        String?
  excerpt        String?
  content        String        @db.Text
  coverImage     String?
  authorId       String?
  category       String
  tags           String[]      @default([])
  seoTitle       String?
  seoDescription String?
  keywords       String[]      @default([])
  readingTime    Int           @default(5)
  likes          Int           @default(0)
  shares         Int           @default(0)
  isFeatured     Boolean       @default(false)
  author         User?         @relation("BlogAuthor", fields: [authorId], references: [id])
  comments       BlogComment[]
  isPublished    Boolean       @default(false)
  publishedAt    DateTime?
  views          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([isPublished, publishedAt])
  @@map("blog_posts")
}

model BlogComment {
  id         String        @id @default(uuid())
  postId     String
  post       BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String        @db.Text
  parentId   String?
  parent     BlogComment?  @relation("BlogCommentReplies", fields: [parentId], references: [id])
  replies    BlogComment[] @relation("BlogCommentReplies")
  likes      Int           @default(0)
  isApproved Boolean       @default(true)
  createdAt  DateTime      @default(now())

  @@index([postId, createdAt])
  @@map("blog_comments")
}

model SupportTicket {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketNumber String           @unique
  subject      String
  category     String
  priority     String           @default("NORMAL")
  status       String           @default("OPEN")
  assignedTo   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  resolvedAt   DateTime?
  messages     SupportMessage[]

  @@index([userId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String
  senderType  String
  content     String        @db.Text
  attachments String[]      @default([])
  isRead      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model KnowledgeArticle {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  titleEn     String?
  content     String   @db.Text
  category    String
  tags        String[] @default([])
  views       Int      @default(0)
  helpful     Int      @default(0)
  notHelpful  Int      @default(0)
  isPublished Boolean  @default(false)

  @@index([category, isPublished])
  @@map("knowledge_articles")
}

model Market {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  nameEn       String
  nameAr       String
  country      String
  currency     String
  timezone     String
  workingDays  String[] @default([])
  tradingHours Json
  regulator    String
  laws         Json?
  isActive     Boolean  @default(true)

  @@map("markets")
}

model Currency {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  symbol       String
  decimals     Int      @default(2)
  isActive     Boolean  @default(true)
  exchangeRate Float?
  updatedAt    DateTime @updatedAt

  @@map("currencies")
}

model Localization {
  id       String  @id @default(uuid())
  language String
  country  String
  dialect  String?
  key      String
  value    String  @db.Text

  @@unique([language, key])
  @@index([country])
  @@map("localizations")
}
